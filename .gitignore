# The API key lives ONLY in GitHub Actions Secrets — never commit it.

# Secrets / env
.env
.env.*
*.key
secrets*.json

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Local scratch (never commit pulled CSVs or local test output)
/tmp/
*.csv

# Python
__pycache__/

# rr-metrics checkouts made by the refresh job
/.rrm/
/.rrd/

# NOTE: do NOT ignore */data.json: those are the published numbers GitHub Pages serves and the refresh job commits.
